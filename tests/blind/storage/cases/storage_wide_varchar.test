CREATE TABLE iso_marker (id BIGINT PRIMARY KEY, b VARCHAR(8), c VECTOR(2));
INSERT INTO iso_marker VALUES (9, 'nine', '[1,2]');
CREATE TABLE wide (id BIGINT PRIMARY KEY, tag VARCHAR(8), body VARCHAR(30000));

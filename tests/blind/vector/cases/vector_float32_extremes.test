CREATE TABLE fe (id BIGINT PRIMARY KEY, embedding VECTOR(2));
INSERT INTO fe VALUES (1,'[3.4e38,0]'),(2,'[0,3.4e38]'),(3,'[1e-45,-1e-45]'),(4,'[1e38,1e38]'),(5,'[-1e-45,1e-45]'),(6,'[-3.4e38,0]');
SELECT id, L2_DISTANCE(embedding, '[3.4e38,0]') AS d FROM fe WHERE id = 1 ORDER BY d LIMIT 1;
SELECT id, L2_DISTANCE(embedding, '[0,0]') AS d FROM fe WHERE id = 1 ORDER BY d LIMIT 1;
SELECT id, L2_DISTANCE(embedding, '[0,0]') AS d FROM fe WHERE id = 4 ORDER BY d LIMIT 1;
SELECT id, L2_DISTANCE(embedding, '[0,0]') AS d FROM fe WHERE id = 3 ORDER BY d LIMIT 1;
SELECT id, L2_DISTANCE(embedding, '[0,0]') AS d FROM fe WHERE id >= 3 AND id <= 5 ORDER BY d LIMIT 5;
SELECT id, L2_DISTANCE(embedding, '[0,0]') AS d FROM fe WHERE id = 6 ORDER BY d LIMIT 1;
SELECT id, L2_DISTANCE(embedding, '[0,0]') AS d FROM fe ORDER BY d LIMIT 6;

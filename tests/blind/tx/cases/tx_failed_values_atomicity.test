CREATE TABLE docs (id BIGINT PRIMARY KEY, category VARCHAR(8), content VARCHAR(16), embedding VECTOR(2));
INSERT INTO docs VALUES (1, 'a', '一', '[0,0]'), (2, 'a', '二', '[1,0]'), (3, 'b', '三', '[0,2]');
BEGIN;
UPDATE docs SET content = '改' WHERE id = 3;
INSERT INTO docs VALUES (4, 'b', '四', '[0]');
UPDATE docs SET embedding = '[1,1,1]' WHERE id = 2;
UPDATE docs SET content = 100 WHERE id = 1;
SELECT id, content FROM docs ORDER BY id;
COMMIT;
SELECT id, content FROM docs ORDER BY id;
SELECT id, L2_DISTANCE(embedding, '[0,0]') AS distance FROM docs ORDER BY distance LIMIT 3;
--restart
SELECT id, content FROM docs ORDER BY id;
SELECT id, L2_DISTANCE(embedding, '[0,0]') AS distance FROM docs ORDER BY distance LIMIT 3;

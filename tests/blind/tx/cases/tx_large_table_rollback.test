BEGIN;
DELETE FROM docs WHERE id >= 1;
SELECT id FROM docs ORDER BY id LIMIT 3;
ROLLBACK;
SELECT id FROM docs ORDER BY id DESC LIMIT 2;
SELECT id, L2_DISTANCE(embedding, '[0,0]') AS distance FROM docs WHERE category = 'b' ORDER BY distance LIMIT 3;

CREATE TABLE docs (id BIGINT PRIMARY KEY, category VARCHAR(8), content VARCHAR(16), embedding VECTOR(2));
INSERT INTO docs VALUES (1, 'a', '一', '[0,0]'), (2, 'a', '二', '[1,0]'), (3, 'b', '三', '[0,2]');
BEGIN;
INSERT INTO docs VALUES (4, 'b', '四', '[3,4]');
UPDATE docs SET category = 'c' WHERE id = 1;
DELETE FROM docs WHERE id = 2;
SELECT id, category, content FROM docs ORDER BY id;
SELECT id, L2_DISTANCE(embedding, '[0,0]') AS distance FROM docs ORDER BY distance LIMIT 4;
ROLLBACK;
SELECT id, category, content FROM docs ORDER BY id;
SELECT id, L2_DISTANCE(embedding, '[0,0]') AS distance FROM docs WHERE category = 'a' ORDER BY distance LIMIT 3;
--restart
SELECT id, category, content FROM docs ORDER BY id;
SELECT id, content FROM docs WHERE category = 'a' ORDER BY id;

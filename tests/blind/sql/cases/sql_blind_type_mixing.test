CREATE TABLE t (id BIGINT PRIMARY KEY, n BIGINT, s VARCHAR(16));
INSERT INTO t VALUES ('1', '10', 'x');
SELECT id, n FROM t ORDER BY id;
INSERT INTO t VALUES (2, 20, 42);
SELECT s FROM t WHERE id = 2;
SELECT id FROM t WHERE n = '10';
SELECT id FROM t WHERE s = 42;
SELECT id FROM t WHERE id = '2';
SELECT id, n, s FROM t ORDER BY id;
UPDATE t SET n = '99' WHERE id = 1;
SELECT n FROM t WHERE id = 1;
DELETE FROM t WHERE id = '2';

CREATE TABLE t (id BIGINT PRIMARY KEY, v BIGINT);
INSERT INTO t VALUES (5, 10), (1, 10), (3, 10), (2, 20), (4, 20);
SELECT id FROM t ORDER BY v;
SELECT id FROM t ORDER BY v DESC;
SELECT id FROM t ORDER BY v LIMIT 3;
SELECT id FROM t ORDER BY v DESC LIMIT 3;
SELECT id, v FROM t ORDER BY id DESC;
UPDATE t SET v = 10 WHERE id = 4;
SELECT id FROM t ORDER BY v;
SELECT id FROM t ORDER BY v DESC;
SELECT id FROM t WHERE v >= 10 AND v <= 20 ORDER BY v DESC LIMIT 2;
SELECT id FROM t ORDER BY id DESC LIMIT 1;

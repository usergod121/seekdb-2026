CREATE TABLE e (id BIGINT PRIMARY KEY, v VECTOR(3))
SELECT id FROM e ORDER BY id
SELECT id, L2_DISTANCE(v,'[0,0,0]') AS d FROM e ORDER BY d LIMIT 5
DELETE FROM e WHERE id=1
UPDATE e SET v='[1,0,0]' WHERE id=1
INSERT INTO e VALUES (2,'[3,4,0]'),(1,'[0,0,1]')
SELECT id, L2_DISTANCE(v,'[0,0,0]') AS d FROM e ORDER BY d
SELECT id FROM e ORDER BY id DESC

CREATE TABLE k (id BIGINT PRIMARY KEY, tag VARCHAR(8), vec VECTOR(2))
INSERT INTO k VALUES (1,'x','[1,0]'),(2,'x','[0,1]'),(3,'y','[1,1]')
BEGIN
UPDATE k SET vec='[0,0]' WHERE id=1
SELECT id FROM k ORDER BY L2_DISTANCE(vec,'[0,0]') LIMIT 3
ROLLBACK
SELECT id FROM k ORDER BY L2_DISTANCE(vec,'[0,0]') LIMIT 3
BEGIN
DELETE FROM k WHERE id=3
INSERT INTO k VALUES (1,'dup','[0,0]')
SELECT id FROM k ORDER BY id
COMMIT
SELECT id, tag FROM k ORDER BY id
--restart
SELECT id, vec FROM k ORDER BY id
